{:paths ["src"]
 :deps {org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:run  {:main-opts ["-m" "researcher.main"]}
  ;; Live dev REPL: `secretspec run -- clojure -M:repl` (secrets in env), connect
  ;; your editor to the nREPL port; edit .clj + (require ... :reload) to hot-swap.
  :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                      cider/cider-nrepl {:mvn/version "0.50.2"}}
         :main-opts ["-m" "nrepl.cmdline"
                     "--middleware" "[cider.nrepl/cider-middleware]"
                     "--interactive"]}}}
