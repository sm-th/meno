{:paths ["src"]
 :deps {org.clojure/data.json {:mvn/version "2.5.1"}
        org.babashka/sci {:mvn/version "0.8.43"}
        nrepl/nrepl {:mvn/version "1.3.1"}
        cider/cider-nrepl {:mvn/version "0.50.2"}}
 :aliases
 {;; meno CLI: `clojure -M:run ingest <url>`
  :run  {:main-opts ["-m" "researcher.main"]}
  ;; deterministic test suite (no network/omp)
  :test {:extra-paths ["test"]
         :main-opts ["-m" "researcher.test-runner"]}}}
