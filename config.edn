;; researcher configuration.
;; Paths starting with ~ are expanded to the user's home at load time.
{:blog {:root "~/andysmith-ai/andysmith.ai" :url "https://andysmith.ai"}
 :wiki {:root "~/sm-th/smith-wiki"
        :content "content"
        :base "main"        ; branch the worker forks pages from and PRs into
        :conventions "meta/conventions"  ; the meta card holding the card contract
        :author-name "Agent Smith"       ; agent's wiki commits are authored as
        :author-email "agent@smith.wiki"}

 ;; Embeddings: OpenRouter /v1/embeddings, open-weights Qwen3-Embedding-8B
 ;; (hosted now, self-hostable in tower later). Key from secretspec env.
 :embed {:base-url "https://openrouter.ai/api/v1"
         :model "qwen/qwen3-embedding-8b"
         :dim 4096
         :price-per-token 1.0e-8   ; $0.01 / 1M tokens (qwen3-embedding-8b)
         :api-key-env "OPENROUTER_API_KEY"}

 ;; Managed Qdrant Cloud (no local DB). URL + key from secretspec env.
 :qdrant {:url-env "QDRANT_URL"
          :api-key-env "QDRANT_API_KEY"
          :collection "corpus"}

 ;; Linkwarden Cloud: durable store for references cited by notes.
 :linkwarden {:url-env "LINKWARDEN_URL"
              :token-env "LINKWARDEN_TOKEN"
              :collection "researcher"}

 ;; Reference ingestion: extract cited URLs, save to Linkwarden, chunk-embed.
 :refs {:chunk-chars 3200 :chunk-overlap 300 :max-refs-per-note 10}

 ;; Web search: Tavily (free tier). Returns URLs; content fetched via Linkwarden.
 :search {:endpoint "https://api.tavily.com/search"
          :api-key-env "TAVILY_API_KEY"
          :max-results 5}

 ;; All LLM reasoning goes through omp. Model chosen by bench/REPORT.md:
 ;; deepseek-v4-flash via OpenCode Go (top quality/cost on our request types;
 ;; key in ~/.omp/agent/.env OPENCODE_API_KEY). Bump to deepseek-v4-pro only if
 ;; card synthesis looks weak in real PRs.
 :omp {:model "opencode-go/deepseek-v4-flash"}

 ;; Human-review policy: keep the queue tiny. File at most :max-new-per-run new
 ;; issues per run, and stay silent once :wip-cap open issues exist.
 :planner {:max-new-per-run 1
           :wip-cap 10
           :max-tasks-per-note 2}

 ;; Worker (Stage 2): one approved issue -> a per-issue branch -> PR. Runs in the
 ;; living image so the /mcp/worker endpoint is branch-scoped via researcher.task.
 :worker {:branch-prefix "researcher/issue-"}

 ;; GitHub issues = the task queue (planner files, you triage, worker executes).
 :github {:repo "agent-smith-wiki/smith-wiki" :token-env "GH_TOKEN"}

 ;; GitHub Projects v2 = the approval BOARD. Separate CLASSIC token (`project`
 ;; scope) via GraphQL — fine-grained PATs can't grant user-owned Projects. See
 ;; docs/auth.md. :number is filled once the project is created.
 :projects {:owner "agent-smith-wiki"
            :name "researcher"
            :human-login "sm-th"      ; personal GitHub login (project WRITER)
            :link-repo "agent-smith-wiki/smith-wiki"
            :token-env "GH_PROJECTS_TOKEN"
            :graphql "https://api.github.com/graphql"
            :statuses ["Backlog" "Todo" "In Progress" "In Review" "Done" "Denied"]
            :approved-status "Todo"
            :backlog-status "Backlog"}

 ;; The long-lived MCP gateway: HTTP server (one eval tool) into the shared image.
 :gateway {:host "127.0.0.1" :port 7777 :nrepl-port 7778}

 ;; Usage caps (in-memory meter, researcher.budget). The real guard is omp/Claude
 ;; (subscription 5h/weekly quotas) — never starve interactive Claude. OpenRouter
 ;; embeddings are balance-capped already, so their cap is just a safety net.
 :limits {;; omp/Claude — the one that matters (enforced when Step-2 wires omp):
          :omp-max-sessions 3      ; per run
          :llm-usd 0.50            ; per-run omp spend cap
          :llm-quota-reserve 0.5   ; stop if <50% of the 5h Claude window remains
          ;; OpenRouter embeddings — safety net (balance-capped anyway):
          :embed-tokens 300000
          :embed-usd 0.05
          :total-usd 1.00}

 ;; microsandbox (msb 0.6.16) launch profiles.
 ;; Only the WORKER needs a microVM (broad web egress + omp). The PLANNER is
 ;; trusted host code; its profile here is kept for optional isolation only.
 ;;
 ;; Security model relied upon:
 ;;  - egress allowlist:  --net-default-egress deny  +  --net-rule allow@HOST
 ;;  - network-bound secrets: --secret ENV@HOST  (never written to VM disk;
 ;;    only delivered toward the listed hosts) so a malicious fetched page
 ;;    cannot exfiltrate the GitHub token even with broad `public` egress.
 :sandbox
 {:image "researcher:latest"
  :profiles
  {:planner
   {:mounts  [{:src "~/andysmith-ai/andysmith.ai" :dst "/repos/blog" :ro true}]
    :net-default "deny"
    :allow   [{:host "<llm-host>"     :ports "tcp:443"}
              {:host "api.github.com" :ports "tcp:443"}]
    :secrets [{:env "LLM_API_KEY"     :hosts ["<llm-host>"]}
              {:env "GH_TOKEN_ISSUES" :hosts ["api.github.com"]}]
    :max-duration "10m" :idle-timeout "3m"}

   :worker
   {:mounts  [{:src "~/andysmith-ai/andysmith.ai" :dst "/repos/blog" :ro true}]
    ;; wiki is cloned fresh and baked in before boot (isolation, no host coupling)
    :copy-wiki "<fresh-clone smith-wiki>:/repos/wiki"
    :net-default "deny"
    :allow   [{:host "public" :ports nil}]   ; broad web egress to fetch sources
    :secrets [{:env "LLM_API_KEY"   :hosts ["<llm-host>"]}
              {:env "GH_TOKEN_RW"   :hosts ["api.github.com"]}
              {:env "SEARCH_API_KEY" :hosts ["<search-host>"]}]
    :max-duration "30m" :idle-timeout "5m"}}}}
