;; researcher configuration.
;; Paths starting with ~ are expanded to the user's home at load time.
{:blog {:root "~/andysmith-ai/andysmith.ai"}
 :wiki {:root "~/sm-th/smith-wiki"
        :content "content"}

 ;; Embeddings: OpenRouter /v1/embeddings, open-weights Qwen3-Embedding-8B
 ;; (hosted now, self-hostable in tower later). Key from secretspec env.
 :embed {:base-url "https://openrouter.ai/api/v1"
         :model "qwen/qwen3-embedding-8b"
         :dim 4096
         :price-per-token 1.0e-8   ; $0.01 / 1M tokens (qwen3-embedding-8b)
         :api-key-env "OPENROUTER_API_KEY"}

 ;; Managed Qdrant Cloud (no local DB). URL + key from secretspec env.
 :qdrant {:url-env "QDRANT_URL"
          :api-key-env "QDRANT_API_KEY"
          :collection "corpus"}

 ;; All LLM reasoning goes through omp (Claude). Model: Sonnet (inexpensive) —
 ;; watch quality AND cost closely on first runs. Auth via secretspec env
 ;; ANTHROPIC_OAUTH_TOKEN (claude setup-token).
 :omp {:model "claude-sonnet-4-5"   ; verify exact catalog id when wiring omp
       :oauth-token-env "ANTHROPIC_OAUTH_TOKEN"}

 :planner {:max-tasks-per-note 5}

 ;; Usage caps (in-memory meter, researcher.budget). The real guard is omp/Claude
 ;; (subscription 5h/weekly quotas) — never starve interactive Claude. OpenRouter
 ;; embeddings are balance-capped already, so their cap is just a safety net.
 :limits {;; omp/Claude — the one that matters (enforced when Step-2 wires omp):
          :omp-max-sessions 3      ; per run
          :llm-usd 0.50            ; per-run omp spend cap
          :llm-quota-reserve 0.5   ; stop if <50% of the 5h Claude window remains
          ;; OpenRouter embeddings — safety net (balance-capped anyway):
          :embed-tokens 300000
          :embed-usd 0.05
          :total-usd 1.00}

 ;; microsandbox (msb 0.6.16) launch profiles.
 ;; Only the WORKER needs a microVM (broad web egress + omp). The PLANNER is
 ;; trusted host code; its profile here is kept for optional isolation only.
 ;;
 ;; Security model relied upon:
 ;;  - egress allowlist:  --net-default-egress deny  +  --net-rule allow@HOST
 ;;  - network-bound secrets: --secret ENV@HOST  (never written to VM disk;
 ;;    only delivered toward the listed hosts) so a malicious fetched page
 ;;    cannot exfiltrate the GitHub token even with broad `public` egress.
 :sandbox
 {:image "researcher:latest"
  :profiles
  {:planner
   {:mounts  [{:src "~/andysmith-ai/andysmith.ai" :dst "/repos/blog" :ro true}]
    :net-default "deny"
    :allow   [{:host "<llm-host>"     :ports "tcp:443"}
              {:host "api.github.com" :ports "tcp:443"}]
    :secrets [{:env "LLM_API_KEY"     :hosts ["<llm-host>"]}
              {:env "GH_TOKEN_ISSUES" :hosts ["api.github.com"]}]
    :max-duration "10m" :idle-timeout "3m"}

   :worker
   {:mounts  [{:src "~/andysmith-ai/andysmith.ai" :dst "/repos/blog" :ro true}]
    ;; wiki is cloned fresh and baked in before boot (isolation, no host coupling)
    :copy-wiki "<fresh-clone smith-wiki>:/repos/wiki"
    :net-default "deny"
    :allow   [{:host "public" :ports nil}]   ; broad web egress to fetch sources
    :secrets [{:env "LLM_API_KEY"   :hosts ["<llm-host>"]}
              {:env "GH_TOKEN_RW"   :hosts ["api.github.com"]}
              {:env "SEARCH_API_KEY" :hosts ["<search-host>"]}]
    :max-duration "30m" :idle-timeout "5m"}}}}
