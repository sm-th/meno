;; Instance description — the fleet of machines this orchestrator runs, their
;; chat identities (provisioned as Zulip bots), and the accesses each needs.
;; This is the single source of truth: edit it, reconcile converges.
;;
;; Secrets are NOT here. Per-machine values live in the orchestrator's store as
;; <MACHINE>_<SECRET> (e.g. PUBLISHER_GH_TOKEN); the Zulip owner creds and realm
;; come from env: ZULIP_SITE / ZULIP_OWNER_EMAIL / ZULIP_OWNER_API_KEY.
{:zulip {:site-env       "ZULIP_SITE"
         :owner-email-env "ZULIP_OWNER_EMAIL"
         :owner-key-env  "ZULIP_OWNER_API_KEY"
         :host           "chat.gradienthike.com"}   ; egress host for a sandboxed agent's network-bound bot key

 ;; How often the engine runs the publisher poll (zeno.loop schedules it).
 :poll-ms 60000

 ;; Researcher: a sandboxed omp agent (fresh per-post microVM) that ingests each
 ;; published post into the wiki. EVERYTHING runs in the microVM — clone, the agent
 ;; (full native tools + broad web egress), commit and git push; the host only spawns
 ;; it. Every secret is network-bound (msb injects the real value only toward its
 ;; host, even inside git's base64 Basic-auth), so the guest holds only placeholders.
 :research {:wiki-repo    "https://github.com/agent-smith-wiki/smith-wiki.git"
            :wiki-base    "main"
            :image        "zeno-agent:base"
            :manifest-url "https://llm.gradienthike.com/v1"
            :model        "opencode-go/deepseek-v4-flash"
            :git-name     "Agent Smith"
            :git-email    "agent@smith.wiki"}

 ;; Machines. :identity -> a provisioned Zulip bot (chat persona + stream subs).
 ;; :accesses -> catalog keys; :sandboxed -> host env vs network-bound delivery.
 :machines
 {:researcher {:identity  {:chat "Meno Researcher" :streams ["blog" "research"]}
               :accesses  [:github :llm]    ; Manifest key + GH_TOKEN, both network-bound in the VM
               :sandboxed true}
  :publisher  {:identity  {:chat "Blog Publisher" :streams ["blog"]}
               :accesses  [:telegram]      ; host: git push via ssh key, not a delivered token
               :sandboxed false}}

 ;; Access catalog: pre-existing secrets (you created them) + the hosts each may
 ;; be delivered toward. reconcile does NOT create these — only delivers.
 :access-catalog
 {:github   {:secret "GH_TOKEN"           :hosts ["api.github.com" "github.com"]}
  :telegram {:secret "TELEGRAM_BOT_TOKEN" :hosts ["api.telegram.org"]}
  :llm      {:secret "ANTHROPIC_API_KEY"  :hosts ["llm.gradienthike.com"]}}}
